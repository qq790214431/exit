{
  "name": "xhs-desktop",
  "version": "2.2.1",
  "description": "小红书主页链接采集工具（桌面版）",
  "main": "main.js",
  "author": "xhs-desktop",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.xhs.desktop.tool",
    "productName": "小红书主页链接采集工具",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "lib.js",
      "import_links.js",
      "report.js",
      "package.json",
      "scrape.js"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities"
    },
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "runtime/node",
        "to": "runtime/node"
      },
      {
        "from": "runtime/node_modules/playwright-core",
        "to": "runtime/node_modules/playwright-core"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "xlsx": "^0.18.5"
  }
}