{
  "name": "xhs-desktop",
  "version": "1.0.0",
  "description": "小红书主页链接采集工具（桌面版）",
  "main": "main.js",
  "author": "xhs-desktop",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.xhs.desktop.tool",
    "productName": "小红书主页链接采集工具",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "npmRebuild": false
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "xlsx": "^0.18.5"
  }
}
